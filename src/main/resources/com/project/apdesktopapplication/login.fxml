<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<VBox alignment="CENTER" spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" prefWidth="350" prefHeight="320">
    <padding>
        <Insets top="30" bottom="30" left="30" right="30"/>
    </padding>

    <Label text="Login" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <TextField fx:id="emailOrUsernameField" promptText="Email or Username"/>

    <PasswordField fx:id="passwordField" promptText="Password"/>

    <Button fx:id="loginButton" text="Login" maxWidth="Infinity"/>

    <Label fx:id="messageLabel" style="-fx-text-fill: red;"/>

    <Hyperlink fx:id="toSignupLink" text="Don't have an account? Sign up"/>

</VBox>
