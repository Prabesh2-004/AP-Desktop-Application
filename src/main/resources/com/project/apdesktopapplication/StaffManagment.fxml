<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.project.apdesktopapplication.StaffController"
            prefWidth="1440"
            prefHeight="900"
            stylesheets="@staff.css"
            styleClass="root">

    <!-- ================= HEADER ================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="15"
              prefHeight="75"
              styleClass="header">

            <padding>
                <Insets top="15"
                        right="25"
                        bottom="15"
                        left="25"/>
            </padding>

            <Label text="🏢"
                   style="-fx-font-size:30;"/>

            <VBox spacing="3">

                <Label text="Campus Resource Booking"
                       styleClass="header-title"/>

                <Label text="Staff Resource Management Portal"
                       styleClass="header-subtitle"/>

            </VBox>

            <Pane HBox.hgrow="ALWAYS"/>

            <TextField fx:id="searchField"
                       promptText="Search booking requests..."
                       prefWidth="300"/>

            <Button text="Search"
                    styleClass="primary-button"/>

            <Label text="Welcome Staff"
                   styleClass="welcome-label"/>

            <Button fx:id="logoutBtn"
                    text="Logout"
                    styleClass="logout-button"/>

        </HBox>

    </top>

    <!-- ================= SIDEBAR ================= -->

    <left>

        <VBox prefWidth="270"
              spacing="18"
              styleClass="sidebar">

            <padding>
                <Insets top="25"
                        right="20"
                        bottom="25"
                        left="20"/>
            </padding>

            <Label text="Navigation"
                   styleClass="section-title"/>

            <Separator/>

            <Button fx:id="dashboardBtn"
                     text="🏠 Dashboard"
                     maxWidth="Infinity"
                     onAction="#handleDashboard"/>

            <Button fx:id="resourcesBtn"
                     text="📚 Resources"
                     maxWidth="Infinity"
                     onAction="#handleResources"/>

            <Button fx:id="pendingBtn"
                     text="📅 Pending Requests"
                     maxWidth="Infinity"
                     onAction="#handlePending"/>

            <Button fx:id="approvedBtn"
                     text="✔ Approved Bookings"
                     maxWidth="Infinity"
                     onAction="#handleApproved"/>

            <Button fx:id="rejectedBtn"
                     text="❌ Rejected Bookings"
                     maxWidth="Infinity"
                     onAction="#handleRejected"/>

            <Separator/>

            <Label text="Quick Statistics"
                   styleClass="filter-title"/>

            <Label text="Pending : 12"/>

            <Label text="Approved : 46"/>

            <Label text="Rejected : 8"/>

            <Label text="Resources : 24"/>

