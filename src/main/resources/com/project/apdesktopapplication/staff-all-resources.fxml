<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.apdesktopapplication.controllers.StaffAllResourcesController" style="-fx-background-color: #F9FAFB; -fx-padding: 24;">

    <!-- Header -->
    <VBox spacing="4">
        <Label text="📚 All Resources" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: black;"/>
        <Label text="View all resources in the system" style="-fx-text-fill: #6B7280; -fx-font-size: 14px;"/>
    </VBox>

    <!-- Table -->
    <TableView fx:id="resourcesTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 4;">
        <columns>
            <TableColumn fx:id="colId" text="Resource ID" prefWidth="110" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colName" text="Name" prefWidth="200" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colType" text="Type" prefWidth="150" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colLocation" text="Location" prefWidth="180" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colCapacity" text="Capacity" prefWidth="100" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="120" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colCreator" text="Created By" prefWidth="150" style="-fx-font-weight: bold;"/>
        </columns>
    </TableView>

</VBox>