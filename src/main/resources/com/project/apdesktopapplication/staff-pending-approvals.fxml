<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.apdesktopapplication.controllers.StaffPendingApprovalsController" style="-fx-background-color: #F9FAFB; -fx-padding: 24;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="⏳ Pending Approvals" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: black;"/>
        <Label text="Review bookings for your resources" style="-fx-text-fill: #6B7280; -fx-font-size: 14px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox spacing="2" alignment="CENTER_RIGHT" style="-fx-background-color: #FEF3C7; -fx-padding: 8 16 8 16; -fx-background-radius: 6; -fx-border-color: #F59E0B; -fx-border-radius: 6;">
            <Label text="Pending Requests" style="-fx-text-fill: #6B7280; -fx-font-size: 11px;"/>
            <Label fx:id="pendingCountLabel" text="0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #EAB308;"/>
        </VBox>
    </HBox>

    <!-- Table -->
    <TableView fx:id="approvalsTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 4;">
        <columns>
            <TableColumn fx:id="colUser" text="User" prefWidth="200" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colResource" text="Resource" prefWidth="200" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colSchedule" text="Schedule" prefWidth="200" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="120" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="180" style="-fx-font-weight: bold;"/>
        </columns>
    </TableView>

    <!-- Footer -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="🔄 Refresh" onAction="#refresh" style="-fx-background-color: black; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 20 8 20; -fx-cursor: hand; -fx-font-weight: bold;"/>
    </HBox>

</VBox>