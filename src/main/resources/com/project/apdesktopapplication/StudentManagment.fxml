<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.project.apdesktopapplication.StudentController"
            prefWidth="1440"
            prefHeight="900"
            stylesheets="@student.css"
            styleClass="root">

    <!-- ========================= HEADER ========================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="15"
              prefHeight="75"
              styleClass="header">

            <padding>
                <Insets top="15" right="25" bottom="15" left="25"/>
            </padding>

            <Label text="📚"
                   style="-fx-font-size:28;" />

            <VBox spacing="3">

                <Label text="Campus Resource Booking"
                       styleClass="header-title"/>

                <Label text="Find and reserve study spaces, labs and equipment"
                       styleClass="header-subtitle"/>

            </VBox>

            <Pane HBox.hgrow="ALWAYS"/>

            <TextField fx:id="searchField"
                       promptText="Search resources..."
                       prefWidth="300"/>

            <Button text="Search"
                    styleClass="primary-button"/>

            <Label text="Welcome, Pratham"
                   styleClass="welcome-label"/>

            <Button text="Logout"
                    fx:id="logoutBtn"
                    styleClass="logout-button"/>

        </HBox>

    </top>

    <!-- ========================= SIDEBAR ========================= -->

    <left>

        <VBox prefWidth="280"
              spacing="20"
              styleClass="sidebar">

            <padding>
                <Insets top="25"
                        right="20"
                        bottom="25"
                        left="20"/>
            </padding>

            <Label text="Filters"
                   styleClass="section-title"/>

            <Separator/>

            <!-- Resource Type -->

            <VBox spacing="10">

                <Label text="Resource Type"
                       styleClass="filter-title"/>

                <CheckBox text="Study Room"/>

                <CheckBox text="Laboratory"/>

                <CheckBox text="Conference Room"/>

                <CheckBox text="Computer Lab"/>

                <CheckBox text="Equipment"/>

            </VBox>

            <!-- Location -->

            <VBox spacing="8">

                <Label text="Location"
                       styleClass="filter-title"/>

                <ComboBox promptText="Select Building"/>

            </VBox>

            <!-- Capacity -->

            <VBox spacing="8">

                <Label text="Capacity"
                       styleClass="filter-title"/>

                <Slider min="1"
                        max="100"
                        value="20"/>

            </VBox>

            <!-- Availability -->

            <VBox spacing="8">

                <Label text="Availability"
                       styleClass="filter-title"/>

                <CheckBox text="Available Now"/>

            </VBox>

            <Button text="Apply Filters"
                    maxWidth="Infinity"
                    styleClass="primary-button"/>

            <Button text="Clear Filters"
                    maxWidth="Infinity"/>

        </VBox>

    </left>

    <!-- ========================= CENTER ========================= -->

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="20"
                        left="25"/>
            </padding>

            <!-- Dashboard Cards -->

            <HBox spacing="20">

                <VBox prefWidth="220"
                      styleClass="dashboard-card">

                    <padding>
                        <Insets top="20"
                                right="20"
                                bottom="20"
                                left="20"/>
                    </padding>

                    <Label text="Available Resources"
                           styleClass="card-title"/>

                    <Label text="24"
                           styleClass="card-number"/>

                </VBox>

                <VBox prefWidth="220"
                      styleClass="dashboard-card">

                    <padding>
                        <Insets top="20"
                                right="20"
                                bottom="20"
                                left="20"/>
                    </padding>

                    <Label text="My Bookings"
                           styleClass="card-title"/>

                    <Label text="3"
                           styleClass="card-number"/>

                </VBox>

                <VBox prefWidth="220"
                      styleClass="dashboard-card">

                    <padding>
                        <Insets top="20"
                                right="20"
                                bottom="20"
                                left="20"/>
                    </padding>

                    <Label text="Pending Requests"
                           styleClass="card-title"/>

                    <Label text="1"
                           styleClass="card-number"/>

                </VBox>

            </HBox>

            <!-- Section Header -->

            <HBox alignment="CENTER_LEFT">

                <Label text="Available Resources"
                       styleClass="section-title"/>

                <Pane HBox.hgrow="ALWAYS"/>

                <ComboBox promptText="Sort By"
                          prefWidth="180"/>

            </HBox>

            <!-- Resource List -->

            <ScrollPane fitToWidth="true"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color:transparent;">

                <content>

                    <VBox fx:id="resourceContainer"
                          spacing="18">

                        <!-- Resource cards will go here -->
                        <!-- ========================= RESOURCE CARD 1 ========================= -->

                        <HBox spacing="20"
                              styleClass="resource-card">

                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>

                            <!-- Image -->

                            <StackPane prefWidth="180"
                                       prefHeight="130"
                                       styleClass="image-placeholder">

                                <Label text="🖼"
                                       style="-fx-font-size:40;"/>

                            </StackPane>

                            <!-- Details -->

                            <VBox spacing="10"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Science Laboratory"
                                       styleClass="resource-title"/>

                                <Label text="📍 Engineering Block - Floor 4"
                                       styleClass="resource-location"/>

                                <HBox spacing="20">

                                    <Label text="👥 Capacity : 30"/>

                                    <Label text="🆔 Resource ID : LAB-001"/>

                                </HBox>

                                <HBox spacing="15">

                                    <Label text="Available"
                                           styleClass="status-available"/>

                                    <Pane HBox.hgrow="ALWAYS"/>

                                    <Button text="Book Now"
                                            styleClass="book-button"/>

                                </HBox>

                            </VBox>

                        </HBox>

                        <!-- ========================= RESOURCE CARD 2 ========================= -->

                        <HBox spacing="20"
                              styleClass="resource-card">

                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>

                            <StackPane prefWidth="180"
                                       prefHeight="130"
                                       styleClass="image-placeholder">

                                <Label text="📖"
                                       style="-fx-font-size:40;"/>

                            </StackPane>

                            <VBox spacing="10"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Study Room A"
                                       styleClass="resource-title"/>

                                <Label text="📍 Library Building - Floor 2"
                                       styleClass="resource-location"/>

                                <HBox spacing="20">

                                    <Label text="👥 Capacity : 8"/>

                                    <Label text="🆔 Resource ID : STD-204"/>

                                </HBox>

                                <HBox spacing="15">

                                    <Label text="Available"
                                           styleClass="status-available"/>

                                    <Pane HBox.hgrow="ALWAYS"/>

                                    <Button text="Book Now"
                                            styleClass="book-button"/>

                                </HBox>

                            </VBox>

                        </HBox>

                        <!-- ========================= RESOURCE CARD 3 ========================= -->

                        <HBox spacing="20"
                              styleClass="resource-card">

                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>

                            <StackPane prefWidth="180"
                                       prefHeight="130"
                                       styleClass="image-placeholder">

                                <Label text="💻"
                                       style="-fx-font-size:40;"/>

                            </StackPane>

                            <VBox spacing="10"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Computer Laboratory"
                                       styleClass="resource-title"/>

                                <Label text="📍 IT Block - Floor 3"
                                       styleClass="resource-location"/>

                                <HBox spacing="20">

                                    <Label text="👥 Capacity : 40"/>

                                    <Label text="🆔 Resource ID : COM-105"/>

                                </HBox>

                                <HBox spacing="15">

                                    <Label text="Occupied"
                                           styleClass="status-occupied"/>

                                    <Pane HBox.hgrow="ALWAYS"/>

                                    <Button text="Unavailable"
                                            disable="true"/>

                                </HBox>

                            </VBox>

                        </HBox>
                    </VBox>

                </content>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>