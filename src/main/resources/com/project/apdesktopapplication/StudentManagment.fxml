<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.project.apdesktopapplication.StudentController"
            prefWidth="1400"
            prefHeight="850"
            style="-fx-background-color:#F4F6F9;">

    <!-- ================= HEADER ================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="20"
              prefHeight="70"
              style="-fx-background-color:#1565C0;">

            <padding>
                <Insets top="15" right="25" bottom="15" left="25"/>
            </padding>

            <Label text="Campus Resource &amp; Study Space Booking System"
                   style="-fx-text-fill:white;
                          -fx-font-size:22;
                          -fx-font-weight:bold;"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Label text="Welcome, Student"
                   style="-fx-text-fill:white;
                          -fx-font-size:18;"/>

            <Button text="Logout"
                    fx:id="logoutBtn"
                    style="-fx-background-color:#E53935;
                           -fx-text-fill:white;
                           -fx-font-weight:bold;"/>

        </HBox>

    </top>

    <!-- ================= SIDEBAR ================= -->

    <left>

        <VBox spacing="15"
              prefWidth="220"
              style="-fx-background-color:white;">

            <padding>
                <Insets top="20" left="15"/>
            </padding>

            <Button text="🏠 Dashboard" maxWidth="Infinity"/>
            <Button text="📚 Search Resources" maxWidth="Infinity"/>
            <Button text="📖 My Bookings" maxWidth="Infinity"/>
            <Button text="📅 Resource Availability" maxWidth="Infinity"/>

        </VBox>

    </left>

    <!-- ================= MAIN CONTENT ================= -->

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Dashboard Cards -->

            <HBox spacing="20">

                <VBox prefWidth="220"
                      style="-fx-background-color:white;
                             -fx-background-radius:12;
                             -fx-padding:20;">

                    <Label text="Available Resources"
                           style="-fx-font-size:18;
                                  -fx-font-weight:bold;"/>

                    <Label text="28"
                           style="-fx-font-size:36;
                                  -fx-text-fill:#1565C0;"/>

                </VBox>

                <VBox prefWidth="220"
                      style="-fx-background-color:white;
                             -fx-background-radius:12;
                             -fx-padding:20;">

                    <Label text="My Bookings"
                           style="-fx-font-size:18;
                                  -fx-font-weight:bold;"/>

                    <Label text="3"
                           style="-fx-font-size:36;
                                  -fx-text-fill:#2E7D32;"/>

                </VBox>

                <VBox prefWidth="220"
                      style="-fx-background-color:white;
                             -fx-background-radius:12;
                             -fx-padding:20;">

                    <Label text="Pending Requests"
                           style="-fx-font-size:18;
                                  -fx-font-weight:bold;"/>

                    <Label text="1"
                           style="-fx-font-size:36;
                                  -fx-text-fill:#EF6C00;"/>

                </VBox>

            </HBox>

            <!-- Search & Filter -->

            <HBox spacing="10">

                <TextField promptText="Search Resource..."
                           prefWidth="350"/>

                <ComboBox promptText="Type"/>

                <ComboBox promptText="Location"/>

                <ComboBox promptText="Availability"/>

                <Button text="Search"/>

            </HBox>

            <!-- Resource Table -->

            <Label text="Available Resources"
                   style="-fx-font-size:20;
                          -fx-font-weight:bold;"/>

            <TableView fx:id="resourceTable"
                       prefHeight="280">

                <columns>

                    <TableColumn text="ID" prefWidth="80"/>

                    <TableColumn text="Resource"
                                 prefWidth="180"/>

                    <TableColumn text="Type"
                                 prefWidth="160"/>

                    <TableColumn text="Location"
                                 prefWidth="180"/>

                    <TableColumn text="Capacity"
                                 prefWidth="120"/>

                    <TableColumn text="Availability"
                                 prefWidth="130"/>

                    <TableColumn text="Action"
                                 prefWidth="120"/>

                </columns>

            </TableView>

            <!-- Booking Table -->

            <Label text="My Bookings"
                   style="-fx-font-size:20;
                          -fx-font-weight:bold;"/>

            <TableView fx:id="bookingTable"
                       prefHeight="250">

                <columns>

                    <TableColumn text="Booking ID"
                                 prefWidth="120"/>

                    <TableColumn text="Resource"
                                 prefWidth="180"/>

                    <TableColumn text="Date"
                                 prefWidth="150"/>

                    <TableColumn text="Time"
                                 prefWidth="120"/>

                    <TableColumn text="Status"
                                 prefWidth="120"/>

                    <TableColumn text="Action"
                                 prefWidth="140"/>

                </columns>

            </TableView>

            <HBox alignment="CENTER_RIGHT">

                <Button text="Cancel Selected Booking"
                        style="-fx-background-color:#E53935;
                               -fx-text-fill:white;
                               -fx-font-weight:bold;"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>