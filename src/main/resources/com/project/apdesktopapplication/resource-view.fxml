<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="14" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.apdesktopapplication.controllers.ResourceController" style="-fx-background-color: white; -fx-padding: 20;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="📋 Resource Management" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: black;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="totalResourcesLabel" text="Total: 0 resources" style="-fx-text-fill: #6B7280; -fx-font-size: 13px;"/>
    </HBox>

    <!-- Filter bar -->
    <HBox spacing="16" style="-fx-background-color: #F9FAFB; -fx-padding: 14; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8;">
        <VBox spacing="4">
            <Label text="🔍 Type" style="-fx-font-size: 11px; -fx-text-fill: #6B7280; -fx-font-weight: bold;"/>
            <ComboBox fx:id="typeFilter" promptText="All Types" prefWidth="140" style="-fx-border-color: #E5E7EB; -fx-border-radius: 4;"/>
        </VBox>
        <VBox spacing="4">
            <Label text="📍 Location" style="-fx-font-size: 11px; -fx-text-fill: #6B7280; -fx-font-weight: bold;"/>
            <ComboBox fx:id="locationFilter" promptText="All Locations" prefWidth="160" style="-fx-border-color: #E5E7EB; -fx-border-radius: 4;"/>
        </VBox>
        <VBox spacing="4">
            <Label text="👥 Capacity" style="-fx-font-size: 11px; -fx-text-fill: #6B7280; -fx-font-weight: bold;"/>
            <ComboBox fx:id="capacityFilter" promptText="Any Size" prefWidth="120" style="-fx-border-color: #E5E7EB; -fx-border-radius: 4;"/>
        </VBox>
        <VBox spacing="4">
            <Label text="✅ Availability" style="-fx-font-size: 11px; -fx-text-fill: #6B7280; -fx-font-weight: bold;"/>
            <ToggleButton fx:id="availableNowToggle" text="🟢 Available Only"
                          style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 8 16 8 16; -fx-cursor: hand;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="filterIconButton" text="Apply Filters" onAction="#applyFilters"
                style="-fx-background-color: black; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 20 8 20; -fx-cursor: hand; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="resourceTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 4;">
        <columns>
            <TableColumn fx:id="colId" text="Resource ID" prefWidth="120" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colName" text="Name" prefWidth="200" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colType" text="Type" prefWidth="120" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colLocation" text="Location" prefWidth="180" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colCapacity" text="Capacity" prefWidth="90" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="130" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="120" style="-fx-font-weight: bold;"/>
        </columns>
    </TableView>

    <!-- Pagination footer -->
    <HBox alignment="CENTER_LEFT" style="-fx-padding: 10 4 4 4;">
        <Label fx:id="showingLabel" text="Showing resources" style="-fx-text-fill: #6B7280; -fx-font-size: 13px;"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

</VBox>