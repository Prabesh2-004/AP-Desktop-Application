<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.project.apdesktopapplication.controllers.AdminManageUsersController" style="-fx-background-color: #F9FAFB; -fx-padding: 24;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="👥 Manage Users" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: black;"/>
        <Label text="Manage user accounts and permissions" style="-fx-text-fill: #6B7280; -fx-font-size: 14px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="12">
            <VBox spacing="2" alignment="CENTER_RIGHT" style="-fx-background-color: #ECFDF5; -fx-padding: 6 16 6 16; -fx-background-radius: 6; -fx-border-color: #10B981; -fx-border-radius: 6;">
                <Label text="Total Users" style="-fx-text-fill: #6B7280; -fx-font-size: 11px;"/>
                <Label fx:id="totalUsersLabel" text="7" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #16A34A;"/>
            </VBox>
            <Button text="+ Add User" onAction="#handleAddUser"
                    style="-fx-background-color: black; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 10 20 10 20; -fx-cursor: hand; -fx-font-weight: bold;"/>
        </HBox>
    </HBox>

    <!-- Table -->
    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 4;">
        <columns>
            <TableColumn fx:id="colId" text="User ID" prefWidth="100" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colName" text="Full Name" prefWidth="200" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="250" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colRole" text="Role" prefWidth="150" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="120" style="-fx-font-weight: bold;"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="160" style="-fx-font-weight: bold;"/>
        </columns>
    </TableView>

</VBox>