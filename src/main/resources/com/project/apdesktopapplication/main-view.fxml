<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.project.apdesktopapplication.NavigationController" prefWidth="1200" prefHeight="750">

    <!-- Sidebar -->
    <left>
        <VBox spacing="8" prefWidth="220" style="-fx-background-color: black; -fx-padding: 20 12 20 12;">
            <!-- Logo/Header -->
            <VBox spacing="2" style="-fx-padding: 0 0 20 0;">
                <Label text="📋 Resi" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Resource Management" style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px;"/>
            </VBox>

            <Region prefHeight="10"/>

            <Button fx:id="resourcesLink" text="📋 Resources" maxWidth="Infinity" onAction="#showResources"
                    style="-fx-background-color: #1F2937; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-background-radius: 6; -fx-padding: 12 16 12 16; -fx-font-weight: bold;"/>
            <Button fx:id="bookingLink" text="📝 Booking" maxWidth="Infinity" onAction="#showBooking"
                    style="-fx-background-color: transparent; -fx-text-fill: #9CA3AF; -fx-alignment: CENTER_LEFT; -fx-background-radius: 6; -fx-padding: 12 16 12 16; -fx-font-weight: bold;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Footer sidebar -->
            <VBox spacing="4" style="-fx-padding: 16 0 0 0; -fx-border-color: #1F2937; -fx-border-width: 1 0 0 0;">
                <Label text="User: Guest" style="-fx-text-fill: #9CA3AF; -fx-font-size: 12px;"/>
                <Label text="v1.0.0" style="-fx-text-fill: #6B7280; -fx-font-size: 10px;"/>
            </VBox>
        </VBox>
    </left>

    <!-- Page content -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #F9FAFB;"/>
    </center>

</BorderPane>